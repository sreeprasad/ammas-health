ATLAS_HOST=cluster0.xxxxx.mongodb.net
SETUP_ADMIN_USER=setup_admin
SETUP_ADMIN_PASSWORD=
HARNESS_AGENT_USER=harness_agent
HARNESS_AGENT_PASSWORD=
EVAL_RUNNER_USER=eval_runner
EVAL_RUNNER_PASSWORD=

# Agent Engine memory: local dev uses the oe URL printed by `agentengine dev up`
AGENTIC_MEMORY_BASE_URL=http://localhost:8100
# Atlas user for the memory server (readWrite + dbAdmin on amma_memory only)
MEMORY_SERVER_USER=memory_server
MEMORY_SERVER_PASSWORD=

# Cloud memory (service account for the standalone SDK)
AMMA_MEMORY_MODE=local
AGENTIC_MEMORY_CLIENT_ID=
AGENTIC_MEMORY_CLIENT_SECRET=
# AGENTIC_MEMORY_PROJECT_ID is a cloud-only secret; setting it locally breaks the local memory routes
CLOUD_AGENT_URI=
# 96-byte local master key (base64) for explicit encryption of doctor-note text
NOTES_MASTER_KEY=
